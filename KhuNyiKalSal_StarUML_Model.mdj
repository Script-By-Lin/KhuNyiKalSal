              "_type": "UMLDecisionNode",
              "_id": "AAAAAAGNbbd8d256fa9540b58",
              "_parent": {
                "": "AAAAAAGAd6908e41c0124d66b"
              },
              "name": "Check Role Quota Policy"
            },
            {
              "_type": "UMLAction",
              "_id": "AAAAAAGN519ac180b65a4de19",
              "_parent": {
                "": "AAAAAAGAd6908e41c0124d66b"
              },
              "name": "USER Policy (Max 3 Devices)\nIf count >= 3, revoke oldest active session (LRU)"
            },
            {
              "_type": "UMLAction",
              "_id": "AAAAAAGN7e7e6e15f00c4afea",
              "_parent": {
                "": "AAAAAAGAd6908e41c0124d66b"
              },
              "name": "VOLUNTEER Policy (Strict 1-Device Lock)\nRevoke all existing sessions immediately"
            },
            {
              "_type": "UMLAction",
              "_id": "AAAAAAGN5b54b196531e4e808",
              "_parent": {
                "": "AAAAAAGAd6908e41c0124d66b"
              },
              "name": "ORGANIZATION Policy\nPermit concurrent multi-workstation sessions"
            },
            {
              "_type": "UMLAction",
              "_id": "AAAAAAGN0208741f6f06480db",
              "_parent": {
                "": "AAAAAAGAd6908e41c0124d66b"
              },
              "name": "Generate 256-bit Cryptographic Refresh Token\nCompute SHA-256 Digest"
            },
            {
              "_type": "UMLAction",
              "_id": "AAAAAAGN8f100e6fa695424a8",
              "_parent": {
                "": "AAAAAAGAd6908e41c0124d66b"
              },
              "name": "Persist Session to Database with SHA-256 Hash\nSign Short-Lived JWT Access Token (30 min)"
            },
            {
              "_type": "UMLAction",
              "_id": "AAAAAAGN08426aa5134e47afa",
              "_parent": {
                "": "AAAAAAGAd6908e41c0124d66b"
              },
              "name": "Client stores in FlutterSecureStorage\n(Hardware KeyStore / KeyChain)"
            },
            {
              "_type": "UMLActivityFinalNode",
              "_id": "AAAAAAGNc3ec353320d14e049",
              "_parent": {
                "": "AAAAAAGAd6908e41c0124d66b"
              },
              "name": "Session Authenticated"
            }
